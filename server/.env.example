# ─── Server ──────────────────────────────────────────────
PORT=5000

# ─── MongoDB Atlas ───────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/quizcraft?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=7d

# ─── CORS (set to your frontend URL — localhost for dev, Vercel URL for prod) ─
CLIENT_URL=http://localhost:5173

# ─── SMTP (Email) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@quizcraft.app

# ─── AI Service ──────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

